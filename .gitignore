mcp_servers/worldengine/core/experiments/**/tf_logs/
mcp_servers/worldengine/core/logs/

# local IDE/runtime
.sii/

# Local Waymo video library and index (may be a symlink)
/mcp_servers/sentry_video_search/data_waymo_front

# Per-service task workspaces
/mcp_servers/*/runtime/

# Local scene datasets (never publish)
/data/

# Native simulator debug artifacts
/mcp_servers/worldengine/core/projects/SimEngine/dbg/

