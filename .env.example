# adagent .env — secrets only.
# Non-sensitive settings live in each component's config (configs/agent.json,
# configs/video_retriever.json and mcp_servers/*/config.py).

# Agent orchestration LLM (OpenAI-compatible API key)
LLM_API_KEY=
# Dedicated Kimi video retrieval credential (kimi-k3 access required).
KIMI_API_KEY=
# DashScope key for video retrieval / scene validation (Qwen-VL)
DASHSCOPE_API_KEY=
# Alibaba Cloud OSS credentials for sentry rerank staging
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional STS temporary credential
# OSS_SECURITY_TOKEN=
