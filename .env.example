# adagent .env — secrets only.
# Non-sensitive settings live in each component's config (configs/agent.json,
# mcp_servers/*/config.py). The variables below are only required where noted;
# everything else is an optional override and can stay commented out.

# ===== Required secrets =====
# Agent orchestration LLM (OpenAI-compatible API key)
LLM_API_KEY=
# DashScope key for video retrieval / scene validation (Qwen-VL)
DASHSCOPE_API_KEY=
# Alibaba Cloud OSS credentials for sentry rerank staging
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional STS temporary credential
# OSS_SECURITY_TOKEN=

# ===== Optional overrides (defaults already set in component configs) =====
# --- Agent LLM connection (default: configs/agent.json -> llm block) ---
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# LLM_TIMEOUT=600
# OPENAI_MAX_TOKENS=1024

# --- scene validator (tool10; defaults in tools/tool10_scene_validator/real.py) ---
# SCENE_VALIDATOR_MODEL=qwen3-vl-plus
# SCENE_VALIDATOR_TIMEOUT=180

# --- DGGT reconstruction (defaults in mcp_servers/dggt/config.py) ---
# DGGT_ROOT=            # default: mcp_servers/dggt/core
# DGGT_PYTHON=          # default: environments/dggt/.conda/bin/python
# DGGT_SEGFORMER_PYTHON=# default: environments/dggt_segformer/.conda/bin/python
# DGGT_CHECKPOINT=      # default: mcp_servers/dggt/core/pretrained/model_latest_waymo.pth
# DGGT_METERS_TO_DGGT=0.01

# --- Smart Edit (defaults in mcp_servers/smart_edit_client.py) ---
# SMART_EDIT_ROOT=
# SMART_EDIT_ASSET_SCALE=0.01

# --- WorldEngine closed-loop sim (defaults in mcp_servers/worldengine/config.py) ---
# WORLDENGINE_ROOT=     # default: mcp_servers/worldengine/core
# WORLDENGINE_TIMEOUT=86400
# WORLDENGINE_VOCAB=    # only needed for offline candidate-reward scoring

# --- wfa failure analysis (tool01; optional) ---
# Prefers mcp_servers/worldengine_failure_analysis/.secrets/vlm.json (chmod 600).
# WFA_PYTHON=
