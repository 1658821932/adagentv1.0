# adagent .env — secrets only.
# Non-sensitive settings live in each component's config (configs/agent.json,
# mcp_servers/*/config.py). Override them there, not here.

# Agent orchestration LLM (OpenAI-compatible API key)
LLM_API_KEY=
# DashScope key for video retrieval / scene validation (Qwen-VL)
DASHSCOPE_API_KEY=
# Alibaba Cloud OSS credentials for sentry rerank staging
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional STS temporary credential
# OSS_SECURITY_TOKEN=

# Optional UFO local resource paths (no model download)
# UFO_ENV_ROOT=/path/to/existing/ufoex
# UFO_ENTRY_ROOT=/path/to/ufo_video_entry
# UFO_MODEL_SOURCE=/path/to/ufo/source
# UFO_WORLDENGINE_ROOT=/path/to/WorldEngine
# UFO_MOGE_SOURCE=/path/to/moge/source
# UFO_MOGE_CHECKPOINT=/path/to/moge/model.pt
