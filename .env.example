# ===== LLM（Agent 编排 + wfa VLM 备用）===
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# 兼容旧变量名
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60

# ===== 视频检索（DashScope / Qwen-VL）=====
DASHSCOPE_API_KEY=
SCENE_VALIDATOR_MODEL=qwen3-vl-plus
SCENE_VALIDATOR_TIMEOUT=180

# ===== DGGT 重建 =====
# DGGT 核心源码根目录（默认项目内 mcp_servers/dggt/core）
DGGT_ROOT=
# DGGT 主重建 conda 解释器
DGGT_PYTHON=
# SegFormer 预处理 conda 解释器
DGGT_SEGFORMER_PYTHON=
# DGGT 主权重（也可直接放 core/pretrained/model_latest_waymo.pth）
DGGT_CHECKPOINT=
# Smart Edit [前,左,上] 米 -> DGGT 世界坐标缩放
DGGT_METERS_TO_DGGT=0.01

# ===== Smart Edit =====
SMART_EDIT_ROOT=
SMART_EDIT_ASSET_SCALE=0.01

# ===== WorldEngine 闭环仿真 =====
WORLDENGINE_ROOT=
WORLDENGINE_TIMEOUT=86400
# Waymo PDM 词表（policy_runner 离线候选奖励评分用）
WORLDENGINE_VOCAB=

# ===== wfa 失败取证（tool01 real，可选）=====
# 优先用 mcp_servers/worldengine_failure_analysis/.secrets/vlm.json（0600）；
# 如需指定解释器，取消下行注释
# WFA_PYTHON=

