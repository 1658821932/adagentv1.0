# adagent .env — secrets only.
# API addresses/models live in configs/api.json. Agent and service runtime
# settings remain in their own JSON files. Do not put settings here.

# Unified OpenAI-compatible key: agent orchestration, scene editing, WFA
OPENAI_API_KEY=
# DashScope key for video retrieval only (the only Alibaba API consumer)
DASHSCOPE_API_KEY=
# Alibaba Cloud OSS credentials for sentry rerank staging
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional STS temporary credential
# OSS_SECURITY_TOKEN=
