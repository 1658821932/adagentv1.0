# adagent .env — secrets only.
# Non-sensitive settings live in configs/agent.json, tools/*/config.json and
# mcp_servers/*/adapter settings. Override them there, not here.

# Unified OpenAI-compatible key: agent orchestration, SmartEdit, scene validation
OPENAI_API_KEY=
# DashScope key for video retrieval only (the only Alibaba API consumer)
DASHSCOPE_API_KEY=
# Alibaba Cloud OSS credentials for sentry rerank staging
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional STS temporary credential
# OSS_SECURITY_TOKEN=
